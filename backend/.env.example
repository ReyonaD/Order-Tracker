# PostgreSQL connection (Railway provides this automatically as DATABASE_URL)
DATABASE_URL="postgresql://user:password@localhost:5432/order_tracker?schema=public"

# JWT signing secret — set a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"

# Server port (Railway sets PORT automatically)
PORT=3000

# Timezone used for deadline calculation when a store has none set
TZ="America/Chicago"

# Comma-separated list of allowed frontend origins for CORS (optional)
CORS_ORIGINS="http://localhost:5173"

# Set to "true" to skip Shopify HMAC verification during local testing ONLY
SKIP_WEBHOOK_VERIFICATION="false"
